# VPS nginx vhost — saas-identity-platform-flutter
#
# 这份是「参考模板」，不在 nginx include 路径里。.example 后缀让 nginx
# 不会把它当真；由 deploy/saas-identity-platform-flutter.sh 每次 deploy 渲染成
# /etc/nginx/sites-available/<域名>（cert 归一化 + saas.YOUR_DOMAIN 两条 sed，脚本内）。
#
# saas 家族 X08 扩展槽位启用（2026-10-10）：
#   - saas-flutter.xiangru.uk 的 HTTP 301 到 HTTPS
#   - HTTPS 终结在 VPS（泛域 cert *.xiangru.uk）
#   - proxy_pass 到本机容器端口 5108（ADR-0018 SPA 双层：容器内 nginx:alpine :80，
#     host 走 saas 家族 X08 段 5108，由 docker run -p 127.0.0.1:5108:80 决定）
#   - 无 /api/ location：flutter 直连 https://saas-nextjs.xiangru.uk 绝对地址
#     （Dockerfile --dart-define 烘焙），不经本域反代
#
# 注意:不持有 default_server。同一台 VPS 上若多个 vhost 都声明 default_server，
# nginx -t 会报重复——家族 vhost 均不持有，勿加。

server {
    listen 80;
    server_name saas.YOUR_DOMAIN;             # sed 渲染:你的域名
    return 301 https://$host$request_uri;
}

server {
    # http2 走 listen 参数老语法:VPS nginx < 1.25.1 不认独立 `http2 on;` 指令
    # （2026-10-06 expense 首航指纹），勿"升级"
    listen 443 ssl http2;
    server_name saas.YOUR_DOMAIN;             # sed 渲染

    # cert / key 在 VPS 本地，**不入仓**；泛域证书，脚本 sed 归一化为 xiangru-uk.{cert,key}
    ssl_certificate     /etc/nginx/ssl/your-cert.cert;
    ssl_certificate_key /etc/nginx/ssl/your-cert.key;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 浏览器一年 HTTPS-only
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        # VPS 暴露端口（容器内 nginx 监听 :80, host=5108 saas X08 段）
        # 改端口必须同步 deploy/saas-identity-platform-flutter.sh 的 -p 与 Dockerfile EXPOSE
        proxy_pass http://127.0.0.1:5108;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ⚠️ 不加 Upgrade / Connection 头:要配 map 块否则 unknown variable;
        #   Flutter Web SPA 生产 serve 不用 WebSocket。
    }
}
